# Copy to /etc/systemd/system/family-assets.service on the VPS, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now family-assets
[Unit]
Description=Family assets app
After=network.target

[Service]
WorkingDirectory=/root/family
Environment=PORT=8443
Environment=TLS_CERT=/root/family/cert.pem
Environment=TLS_KEY=/root/family/key.pem
Environment=DATA_DIR=/root/family/data
ExecStart=/usr/bin/node /root/family/server.js
Restart=always
User=root

[Install]
WantedBy=multi-user.target
